# Example local GCP config. Copy to .env.gcp or just run ./scripts/gcp/setup.sh
# and answer the prompts — it will create .env.gcp for you.
#
# This file is an example only. Real secrets live in .env.gcp (gitignored).

GCP_PROJECT='your-gcp-project-id'
GCP_REGION='asia-east1'
CLOUD_SQL_INSTANCE='rtsw-pg'
CLOUD_SQL_DB='rtsw'
CLOUD_SQL_USER='rtsw'
ARTIFACT_REPO='rtsw'
CLOUD_RUN_SERVICE='rtsw'
CLOUD_RUN_SEED_JOB='rtsw-seed'
BOOTSTRAP_ADMIN_USER='admin'
BOOTSTRAP_ADMIN_PASSWORD='change-me'
# DB_PASSWORD and JWT_SECRET are generated by setup.sh if omitted.
